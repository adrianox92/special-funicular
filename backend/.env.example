# Copia a .env y rellena los valores.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Imágenes nuevas (catálogo, logos, vehículos) en un bucket privado de Cloudflare R2.
# Sin "r2" o con alguna variable R2_* vacía se sube a Supabase Storage. La BD guarda
# <PUBLIC_IMAGE_ORIGIN>/api/img/r2/<bucket>/<ruta>; Vercel necesita R2_ACCOUNT_ID, R2_BUCKET
# y un token de solo lectura para servirlas. Ver docs/DEPLOY.md.
# IMAGE_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=slotdatabase-images

# Secreto compartido con RevenueCat → Webhooks → Authorization
REVENUECAT_WEBHOOK_SECRET=

# Clave opcional para integraciones externas (la UI admin usa JWT + LICENSE_ADMIN_EMAILS)
ADMIN_SECRET_KEY=FBDB8efYKoW+1RGLA76nZInts9toao7sa0dKUK4c1Sw=

# Admins que reciben el email al canjear un código promo de Slot Lap Timer
LICENSE_ADMIN_EMAILS=

# Resend (waitlist de competiciones, canje de códigos promo, informe de huecos e informe del cron de ofertas)
RESEND_API_KEY=
RESEND_FROM=
FRONTEND_URL=

# Destinatarios del informe de referencias de garaje ausentes del catálogo (lunes y jueves; coma-separados)
CATALOG_GAP_REPORT_TO=adrianpalomera17@gmail.com
# Informe del cron de ofertas. Si falta, se usa CATALOG_GAP_REPORT_TO.
# SHOP_OFFER_REPORT_TO=adrianpalomera17@gmail.com
# CATALOG_GAP_REPORT_LIMIT=40

# Secreto Bearer para POST /api/cron/* (Render Cron Job)
CRON_SECRET=

# Filtro de bots del catálogo público (/api/public/catalog y sitemap-catalog-*.xml).
# El frontend (Vercel) debe usar el mismo CATALOG_INTERNAL_SECRET para que el SSR
# pueda leer la API. Si no se define, el UA SlotDatabase-CatalogSSR/1.0 se acepta.
# CATALOG_INTERNAL_SECRET=
# CATALOG_BOT_GATE=off
# CATALOG_GOOGLE_VERIFY=off

# Origen absoluto de /api/img en JSON público del catálogo (sin barra final).
# Si falta, se usa PUBLIC_SITE_ORIGIN o https://www.slotdatabase.es.
# PUBLIC_IMAGE_ORIGIN=https://www.slotdatabase.es
# PUBLIC_SITE_ORIGIN=https://www.slotdatabase.es
# El conector MCP anuncia este origen (https://www.slotdatabase.es/mcp).
# No uses el host de Render en la documentación ni en los metadatos OAuth.

# IPs bloqueadas en /api/public/catalog, SSR del catálogo y /api/img (coma-separado; CIDR ok).
# Mismo valor en Render (API) y Vercel (frontend). Cambiar la lista = editar env + redeploy.
# No afecta a /api/sync/*.
# BLOCKED_IPS=90.94.193.52
